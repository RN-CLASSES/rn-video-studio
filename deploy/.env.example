# Copy to .env and edit.
API_DOMAIN=api.yourdomain.com                 # DNS A-record must point to this server
CORS_ORIGINS=https://yourdomain.com           # the website allowed to use the API (comma separated)

# Optional but recommended: lets the studio read word problems and photos of handwriting.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# Capacity / protection (defaults shown)
MAX_WORKERS=2
MAX_QUEUE=20
RATE_LIMIT_PER_HOUR=20
JOB_TTL_MINUTES=120
